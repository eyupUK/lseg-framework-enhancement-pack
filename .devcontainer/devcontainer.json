{
  "name": "Microservices Quality Engineering",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/terraform:1": {}
  },
  "postCreateCommand": "mvn -DskipTests install && python -m pip install -r lambda/order-audit/requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-python.python",
        "hashicorp.terraform",
        "redhat.vscode-yaml"
      ]
    }
  }
}
